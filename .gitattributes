# Normalize every text file to LF in the repository, whatever the working tree
# uses, so a Windows checkout and a Linux checkout produce identical commits.
* text=auto eol=lf

*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf

# Binary fixtures, if any are ever added
*.zip   binary
*.png   binary
*.webp  binary
